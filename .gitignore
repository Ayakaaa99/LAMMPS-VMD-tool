# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.spec
.installed.cfg
*.egg

# ==========================================
# Local user configuration & cached paths
# (Avoid committing local VMD executable path or history)
# ==========================================
*.json
*.ini
*.cfg
*.yaml
*.yml
.lammps_vmd*
.vmd_config*
config.py

# ==========================================
# LAMMPS Data & Trajectory files
# (Exclude all user data files, keep only examples/)
# ==========================================
*.data
*.lmp
data.*
*.dump
*.lammpstrj
*.xyz
*.pdb
*.gro
!examples/*.data
!examples/*.lmp

# ==========================================
# Generated VMD / visualization scripts
# ==========================================
*.vmd
*.vmdrun
*.tcl
!vmd_plugin/lammps_loader.tcl

# ==========================================
# Temporary files, logs, and screenshots
# ==========================================
*.log
*.out
*.tmp
*.png
*.jpg
*.jpeg

# ==========================================
# IDE & Operating System files
# ==========================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

