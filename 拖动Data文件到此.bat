@echo off
setlocal
cd /d "%~dp0"

:: 检查 Python 是否可用
set "PYTHON_CMD=python"
where %PYTHON_CMD% >nul 2>&1
if errorlevel 1 (
    set "PYTHON_CMD=py"
    where %PYTHON_CMD% >nul 2>&1
    if errorlevel 1 (
        echo ==============================================================================
        echo   [ERROR] 未检测到 Python 运行环境！
        echo   请确保已安装 Python 并将其勾选添加到系统环境变量 PATH。
        echo ==============================================================================
        pause
        exit /b 1
    )
)

if "%~1"=="" (
    echo ==============================================================================
    echo   LAMMPS Data 到 VMD 极速展示工具
    echo ==============================================================================
    echo   提示: 将任意 LAMMPS .data 文件拖入此图标，即可直接在 VMD 中展示！
    echo   未拖入文件，现在直接打开主配置界面...
    echo ==============================================================================
    %PYTHON_CMD% run_gui.py
    goto end
)

echo ==============================================================================
echo   LAMMPS Data 到 VMD 极速展示
echo ==============================================================================
echo   [*] 目标文件: %~nx1
echo   [*] 正在解析数据并唤起 VMD 渲染...
echo ==============================================================================

%PYTHON_CMD% -m lammps_vmd_tool.cli.main "%~1" -l

if errorlevel 1 (
    echo.
    echo ==============================================================================
    echo   [提示] 启动失败。如果尚未指定 VMD 安装路径，请先运行 run_gui.bat 配置 VMD 路径。
    echo ==============================================================================
    pause
)

:end
